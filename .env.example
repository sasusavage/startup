# Copy to .env for local work. .env is gitignored — never commit real values.
# In production these go in Coolify → Environment Variables.

# --- Database ---------------------------------------------------------------
# External Postgres, SHARED with the portfolio site (../port). Our tables are
# confined to DB_SCHEMA; the public schema belongs to that system — leave it be.
# A "postgres://" scheme is rewritten to "postgresql://" automatically.
# Must be a host this container can resolve: use the public host:port, or put
# the app on the database's Docker network to use the internal name.
DATABASE_URL=
DB_SCHEMA=sasusync_site

# --- Telegram ---------------------------------------------------------------
# Bot token from @BotFather. SECRET — the browser never sees it.
TELEGRAM_BOT_TOKEN=
# Chat id from @userinfobot, or a group id (a negative number).
TELEGRAM_CHAT_ID=

# --- Admin dashboard --------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Signs admin session tokens. Generate: openssl rand -hex 32
JWT_SECRET=

# --- Web --------------------------------------------------------------------
# Only needed if something on another domain calls this API. The site itself is
# served by the same process, so it is same-origin and needs no entry here.
CORS_ORIGINS=https://sasusync.com,https://www.sasusync.com
