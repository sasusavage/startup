# Copy to .env and fill in. .env is gitignored — never commit real values.
# Read at runtime by docker compose. None of it reaches the browser.

# --- Database ---------------------------------------------------------------
# External Postgres, SHARED with the SMS platform (venfy2). Our tables are
# confined to DB_SCHEMA; the public schema belongs to that system — leave it be.
# A "postgres://" scheme is rewritten to "postgresql://" automatically.
DATABASE_URL=
DB_SCHEMA=sasusync_site

# --- Telegram ---------------------------------------------------------------
# Bot token from @BotFather. SECRET — never goes in the frontend bundle.
TELEGRAM_BOT_TOKEN=
# Chat id from @userinfobot, or a group id (a negative number).
TELEGRAM_CHAT_ID=

# --- Admin dashboard --------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Signs admin session tokens. Generate: openssl rand -hex 32
JWT_SECRET=

# --- Web --------------------------------------------------------------------
CORS_ORIGINS=https://sasusync.com,https://www.sasusync.com
WEB_PORT=80
