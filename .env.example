# Copy to .env for local dev. Never commit the real .env — .gitignore covers it.

# BUILD TIME (baked into the JS bundle by Vite — publicly visible, not a secret).
# Your Telegram chat id. Get it by messaging @userinfobot on Telegram.
VITE_TELEGRAM_CHAT_ID=

# RUNTIME (read by nginx inside the container — SECRET, never reaches the browser).
# Bot token from @BotFather. Set this on the host/deploy platform, not here.
TELEGRAM_BOT_TOKEN=
