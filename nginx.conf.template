# Rendered at container start by nginx's envsubst entrypoint.
# API_UPSTREAM is the backend address, e.g. "api:8000".

limit_req_zone $binary_remote_addr zone=contact:10m rate=6r/m;

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Docker's embedded DNS. Paired with the variable in proxy_pass below, this
  # defers name resolution to request time. Without it nginx resolves the
  # upstream at startup and REFUSES TO BOOT if the API is down or absent —
  # taking the whole static site with it. This way the site always serves and
  # only /api/* returns 502 when the backend is missing.
  resolver 127.0.0.11 ipv6=off valid=10s;
  set $api_upstream "${API_UPSTREAM}";

  location / {
    try_files $uri $uri/ /index.html;
  }

  location ~* \.(?:css|js|jpg|jpeg|gif|png|svg|ico|webp|woff2?)$ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # Contact form. Rate limited because each call sends a Telegram message.
  location = /api/contact {
    limit_req zone=contact burst=3 nodelay;
    limit_except POST OPTIONS { deny all; }

    proxy_pass http://$api_upstream$request_uri;
    include /etc/nginx/proxy_headers.conf;
  }

  # Everything else the API owns: products, admin, docs, health.
  location /api/ {
    proxy_pass http://$api_upstream$request_uri;
    include /etc/nginx/proxy_headers.conf;
  }
}
