# Rendered at container start by nginx's envsubst entrypoint.
# API_UPSTREAM is the backend address, e.g. "api:8000".

limit_req_zone $binary_remote_addr zone=contact:10m rate=6r/m;

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  location / {
    try_files $uri $uri/ /index.html;
  }

  location ~* \.(?:css|js|jpg|jpeg|gif|png|svg|ico|webp|woff2?)$ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # Contact form. Rate limited because each call sends a Telegram message.
  location = /api/contact {
    limit_req zone=contact burst=3 nodelay;
    limit_except POST OPTIONS { deny all; }

    proxy_pass http://${API_UPSTREAM};
    include /etc/nginx/proxy_headers.conf;
  }

  # Everything else the API owns: products, admin, docs, health.
  location /api/ {
    proxy_pass http://${API_UPSTREAM};
    include /etc/nginx/proxy_headers.conf;
  }
}
